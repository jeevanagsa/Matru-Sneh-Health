<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/primary_pink"
        android:padding="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍲 Nutrition Checklist"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvClearAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Clear"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"/>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily Food Intake"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <CheckBox
                android:id="@+id/cbRagi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌾 Ragi (Finger Millet)"
                android:textSize="18sp"
                android:textColor="@color/text_dark"
                android:padding="12dp"
                android:layout_marginBottom="8dp"/>

            <CheckBox
                android:id="@+id/cbMilk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🥛 Milk / Curd"
                android:textSize="18sp"
                android:textColor="@color/text_dark"
                android:padding="12dp"
                android:layout_marginBottom="8dp"/>

            <CheckBox
                android:id="@+id/cbLeafy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🥬 Green Leafy Vegetables"
                android:textSize="18sp"
                android:textColor="@color/text_dark"
                android:padding="12dp"
                android:layout_marginBottom="8dp"/>

            <CheckBox
                android:id="@+id/cbPulses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🫘 Pulses &amp; Dals"
                android:textSize="18sp"
                android:textColor="@color/text_dark"
                android:padding="12dp"
                android:layout_marginBottom="8dp"/>

            <CheckBox
                android:id="@+id/cbFruits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🍎 Seasonal Fruits"
                android:textSize="18sp"
                android:textColor="@color/text_dark"
                android:padding="12dp"
                android:layout_marginBottom="8dp"/>

            <CheckBox
                android:id="@+id/cbBeans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🫛 Beans &amp; Peas"
                android:textSize="18sp"
                android:textColor="@color/text_dark"
                android:padding="12dp"
                android:layout_marginBottom="8dp"/>

            <CheckBox
                android:id="@+id/cbNuts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🥜 Nuts &amp; Seeds"
                android:textSize="18sp"
                android:textColor="@color/text_dark"
                android:padding="12dp"
                android:layout_marginBottom="8dp"/>

            <CheckBox
                android:id="@+id/cbEggs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🥚 Eggs / Lean Meat"
                android:textSize="18sp"
                android:textColor="@color/text_dark"
                android:padding="12dp"
                android:layout_marginBottom="8dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>